            "measured": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "notRun": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "parityPass": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "parityFail": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "parityNotApplicable": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "total",
            "measured",
            "notRun",
            "failed",
            "parityPass",
            "parityFail",
            "parityNotApplicable"
          ],
          "additionalProperties": false
        },
        "agent_e2e": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "measured": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "notRun": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "parityPass": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "parityFail": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "parityNotApplicable": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
