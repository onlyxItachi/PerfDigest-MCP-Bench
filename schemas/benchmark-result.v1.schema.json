              "median",
              "min",
              "max",
              "mean",
              "stdev"
            ],
            "additionalProperties": false
          },
          "cgroupTreePeakKb": {
            "type": "object",
            "properties": {
              "unit": {
                "type": "string",
                "enum": [
                  "ms",
                  "us",
                  "s",
                  "kb"
                ]
              },
              "n": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "median": {
                "type": "number"
