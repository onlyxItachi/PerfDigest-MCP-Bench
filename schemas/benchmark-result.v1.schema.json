            "measured": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "notRun": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "parityPass": {
